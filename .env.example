# ElevenLabs narration (required for rendered video; --audit runs without it)
ELEVENLABS_API_KEY=
# Default base URL for [go /relative/path] targets (can be overridden with --url)
BASE_URL=http://localhost:5173
# ElevenLabs voice to narrate with (default: the premade "Rachel" voice)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
